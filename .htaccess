# dentalpassion — przekierowania ze starej struktury WordPress (index.php)
# Wymaga Apache + mod_rewrite. Na cyberFolks zwykle działa w katalogu public_html.

Options -Indexes
RewriteEngine On

# Wymuś HTTPS (odkomentuj po wdrożeniu certyfikatu)
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Stare permalinki WP z index.php
RewriteRule ^index\.php/cennik/?$ /cennik.html [R=301,L]
RewriteRule ^index\.php/rodo/?$ /rodo.html [R=301,L]
RewriteRule ^index\.php/prawa-pacjenta/?$ /prawa-pacjenta.html [R=301,L]
RewriteRule ^index\.php/polityka-prywatnosci/?$ /polityka-prywatnosci.html [R=301,L]
RewriteRule ^index\.php/?$ / [R=301,L]

# Krótsze aliasy bez .html (opcjonalne, ładniejsze URL)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(o-nas|zespol|cennik|kontakt|rodo|prawa-pacjenta|polityka-prywatnosci)/?$ /$1.html [L]

# Typy MIME / kompresja zostaw serwerowi hostingu
